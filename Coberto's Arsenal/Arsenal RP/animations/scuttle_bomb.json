{
  "format_version": "1.8.0",
  "animations": {
    // Quick scuttling steps: diagonal leg pairs swing together, faster and wider the faster it moves.
    "animation.thecoberto.scuttle_bomb.walk": {
      "loop": true,
      "bones": {
        "leg_front_left": { "rotation": [ "math.cos(q.modified_distance_moved * 60) * 45 * q.modified_move_speed", 0, 0 ] },
        "leg_back_right": { "rotation": [ "math.cos(q.modified_distance_moved * 60) * 45 * q.modified_move_speed", 0, 0 ] },
        "leg_front_right": { "rotation": [ "-math.cos(q.modified_distance_moved * 60) * 45 * q.modified_move_speed", 0, 0 ] },
        "leg_back_left": { "rotation": [ "-math.cos(q.modified_distance_moved * 60) * 45 * q.modified_move_speed", 0, 0 ] },
        "body": { "position": [ 0, "math.abs(math.sin(q.modified_distance_moved * 60)) * 0.5 * q.modified_move_speed", 0 ] }
      }
    },
    // Legs folded in while it's flying through the air.
    "animation.thecoberto.scuttle_bomb.folded": {
      "loop": true,
      "bones": {
        "leg_front_left": { "rotation": [ -60, 0, 0 ] },
        "leg_front_right": { "rotation": [ -60, 0, 0 ] },
        "leg_back_left": { "rotation": [ 60, 0, 0 ] },
        "leg_back_right": { "rotation": [ 60, 0, 0 ] }
      }
    }
  }
}
