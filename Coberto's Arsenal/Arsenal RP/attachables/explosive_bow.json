{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "thecoberto:explosive_bow",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/items/explosive_bow",
        "bow_pulling_0": "textures/items/explosive_bow_pulling_0",
        "bow_pulling_1": "textures/items/explosive_bow_pulling_1",
        "bow_pulling_2": "textures/items/explosive_bow_pulling_2",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.bow_standby",
        "bow_pulling_0": "geometry.bow_pulling_0",
        "bow_pulling_1": "geometry.bow_pulling_1",
        "bow_pulling_2": "geometry.bow_pulling_2"
      },
      "animations": {
        "wield": "animation.bow.wield",
        "wield_first_person_pull": "animation.bow.wield_first_person_pull"
      },
      "scripts": {
        "pre_animation": [
          "variable.draw_ticks = query.main_hand_item_use_duration > 0.0 ? query.main_hand_item_max_duration - query.main_hand_item_use_duration : -1.0;"
        ],
        "animate": [
          "wield",
          { "wield_first_person_pull": "query.main_hand_item_use_duration > 0.0 && c.is_first_person" }
        ]
      },
      "render_controllers": [ "controller.render.thecoberto.custom_bow" ]
    }
  }
}
